{
  "name": "noktra",
  "version": "0.1.0",
  "private": true,
  "description": "noktra monorepo: the noktra wizard plus three independent visual regression engines (crawler, snapshot, diff)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "crawl": "node packages/noktra-crawler/src/cli.js",
    "snapshot": "node packages/noktra-snapshot/src/cli.js",
    "diff": "node packages/noktra-diff/src/cli.js",
    "install:browser": "npx playwright install chromium",
    "wizard": "node packages/noktra-cli/src/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
